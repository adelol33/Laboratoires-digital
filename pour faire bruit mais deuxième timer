#include "project.h"
#include "math.h"

float sinWave[100];
int in = 0;


CY_ISR(Timer_DAC_handler)
{
     Timer_ReadStatusRegister(); /* remet le bit TC à 0 automatiquement, on le met en début pour qu'il switch 
    direct à 0, le timer continue en arrière plan. Si on le mettait à la fin, y aurait un delai.*/
    float sample = 100*sinWave[in]; 
    VDAC_SetValue(sample);
        in ++; 
        if (in == 100) {
            in = 0; 
    }
}
        
int main(void)
{
    CyGlobalIntEnable; /* Enable global interrupts. */
    Timer_Start();
    VDAC_Start(); 
    isr_StartEx(Timer_DAC_handler);
