#include "project.h"
#include "keypad.h"
#include <stdint.h>

#define SERVO_REPOS     2000u
#define SERVO_ACTION    1500u
#define TEMPS_ALLER     300u  // temps pour aller en position action (à ajuster)
#define TEMPS_RETOUR    300u  // temps pour revenir en position repos (à ajuster)

uint16_t score = 0;
uint8_t  gameRunning = 0; 
uint32_t timerMS = 0;

void AffichageAction(char* texte) {
    LCD_Position(0, 0);
    LCD_PrintString("                "); 
    LCD_Position(0, 0);
    LCD_PrintString(texte);
}

void AffichageScore() {
    LCD_Position(1, 0);
    LCD_PrintNumber(score);
    LCD_PrintString("    "); 
}

int main(void)
{
    CyGlobalIntEnable;

    PWM_Start();
    keypadInit();
    LCD_Start();
    LCD_ClearDisplay();
    AffichageScore();

    PWM_WriteCompare1(SERVO_REPOS);
    PWM_WriteCompare2(SERVO_REPOS);
    LED1_Write(1);
    LED2_Write(1);
    LED3_Write(1);
    LED4_Write(1);

    for(;;)
    {
        if (gameRunning == 1) 
        {
            CyDelay(10); 
            timerMS += 10;
            
            // On utilise un "while" au cas où timerMS dépasse 1000 de beaucoup
            while (timerMS >= 1000) {
                score += 10;
                timerMS -= 1000; // On soustrait 1000 au lieu de mettre à 0 pour garder les ms restantes
                AffichageScore();
            }
        }
        else {
            CyDelay(10);
        }
        
        char key = keypadScan();
        uint8_t actionEnCours = 0;

        /* ====================================================
           JUMP : * ou SWJ
           ==================================================== */
        if (key == '*')
        {
            // 1. Envoyer commande position action
            actionEnCours = 1;
            if (gameRunning == 0) gameRunning = 1;
            AffichageAction("JUMP!");
            PWM_WriteCompare1(SERVO_ACTION);
            LED1_Write(1);
            LED2_Write(1);
            // 2. Attendre que le servo atteigne sa position action
            CyDelay(TEMPS_ALLER);
            timerMS += TEMPS_ALLER;
            // 3. Envoyer commande position repos
            PWM_WriteCompare1(SERVO_REPOS);
            LED1_Write(0);
            LED2_Write(0);
            // 4. Attendre que le servo atteigne sa position repos
            CyDelay(TEMPS_RETOUR);
            timerMS += TEMPS_RETOUR;
       
        }
        else if (SWJ_Read() == 1u)
        {
            actionEnCours = 1;
            if (gameRunning == 0) gameRunning = 1;
            PWM_WriteCompare1(SERVO_ACTION);
            AffichageAction("JUMP!");
            LED1_Write(1);
            LED2_Write(1);
        }
        else
        {
            PWM_WriteCompare1(SERVO_REPOS);
            LED1_Write(0);
            LED2_Write(0);
        }

        /* ====================================================
           DUCK : # ou SWD
           ==================================================== */
        if (key == '#')
        {
            // 1. Envoyer commande position action
            actionEnCours = 1;
            AffichageAction("DUCK!");
            PWM_WriteCompare2(SERVO_ACTION);
            LED3_Write(1);
            LED4_Write(1);
            // 2. Attendre que le servo atteigne sa position action
            CyDelay(TEMPS_ALLER);
            timerMS += TEMPS_ALLER;
            // 3. Envoyer commande position repos
            PWM_WriteCompare2(SERVO_REPOS);
            LED3_Write(0);
            LED4_Write(0);
            // 4. Attendre que le servo atteigne sa position repos
            CyDelay(TEMPS_RETOUR);
            timerMS += TEMPS_RETOUR;
        }
        else if (SWD_Read() == 1u)
        
        {
            actionEnCours = 1;
            AffichageAction("DUCK!");
            PWM_WriteCompare2(SERVO_ACTION);
            LED3_Write(1);
            LED4_Write(1);
        }
        else
        {
            PWM_WriteCompare2(SERVO_REPOS);
            LED3_Write(0);
            LED4_Write(0);
        }
        if (SWR_Read() == 1u)
        {
            actionEnCours = 1;
            score = 0;
            gameRunning = 0;
            timerMS = 0;
            AffichageAction("RESET");
            AffichageScore();
        }
        if (actionEnCours == 0)
        {
        AffichageAction(""); 
        }
    }
}
