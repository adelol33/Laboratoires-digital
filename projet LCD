#include "project.h"
#include <stdint.h>

#define SERVO_REPOS    1500u  
#define SERVO_ACTION   1900u

uint16_t score = 0;
uint8_t  gameRunning = 0; 
uint32_t timerMS = 0;

void AffichageAction(char* texte) {
    LCD_Position(0, 0);
    LCD_PrintString("                "); // Efface la ligne
    LCD_Position(0, 0);
    LCD_PrintString(texte);
}

void AffichageScore() {
    LCD_Position(1, 0);
    LCD_PrintString("Score: ");
    LCD_PrintNumber(score);
    LCD_PrintString("    "); 
}

int main(void)
{
    CyGlobalIntEnable; 
    PWM_Jump_Start();
    PWM_Duck_Start();
    LCD_Start();
    
    PWM_Jump_WriteCompare(SERVO_REPOS);
    PWM_Duck_WriteCompare(SERVO_REPOS);
    LCD_ClearDisplay();
    AffichageScore();

    for(;;) // --- DEBUT DE LA BOUCLE (Accolade ajoutée ici !) ---
    {
        // 1. GESTION DU JUMP
        if (Switch_Jump_Read() == 0u) 
        {
            PWM_Jump_WriteCompare(SERVO_ACTION);
            AffichageAction("JUMP!");
            if (gameRunning == 0) gameRunning = 1; 
            
            // On reste ici tant qu'on appuie
            while(Switch_Jump_Read() == 0u) { CyDelay(10); } 
            
            // Dès qu'on lâche : on nettoie
            PWM_Jump_WriteCompare(SERVO_REPOS);
            AffichageAction(""); 
        }

        // 2. GESTION DU DUCK
        else if (Switch_Duck_Read() == 0u) 
        {
            PWM_Duck_WriteCompare(SERVO_ACTION);
            if (gameRunning == 1) AffichageAction("DUCK!");
            
            while(Switch_Duck_Read() == 0u) { CyDelay(10); }
            
            PWM_Duck_WriteCompare(SERVO_REPOS);
            AffichageAction("");
        }

        // 3. GESTION DU RESET (Indépendant du else if)
        if (Switch_Reset_Read() == 0u) 
        {
            score = 0;
            gameRunning = 0;
            timerMS = 0;
            AffichageAction("RESET...");
            AffichageScore();
            while(Switch_Reset_Read() == 0u) { CyDelay(10); }
            CyDelay(200);
            AffichageAction(""); // On efface le mot RESET
        }

        // 4. CHRONO DU SCORE
        if (gameRunning == 1) 
        {
            CyDelay(10); 
            timerMS += 10;
            if (timerMS >= 1000) {
                score += 10;
                timerMS = 0;
                AffichageScore();
            }
        }
        else 
        {
            CyDelay(10); // Petite pause pour ne pas saturer le CPU au repos
        }
    } // --- FIN DE LA BOUCLE ---
}
