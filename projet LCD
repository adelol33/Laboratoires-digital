/* -----------------------------------------------
 * Map_ADC_To_Angle
 * Quand obscurité : mappe la valeur ADC (0 -> seuil)
 * sur une plage d'angle (90° -> 180°)
 * Plus il fait sombre, plus l'angle est grand. ATTENTION A METTRE EN COMMUN AVEC LES SERVO QUAND ILS VONT FONCTIONNER!!!!
 * ----------------------------------------------- */
uint16 Map_ADC_To_Angle(int16 adcValue)
{
    uint32 angle;

    if (adcValue < 0) adcValue = 0;

    /* Obscurité totale (ADC = 0)  -> 180°
       Limite obscurité (ADC = seuil) -> 90°  */
    if ((uint16)adcValue >= DARKNESS_THRESHOLD)
    {
        return 90u; /* juste au seuil -> 90° */
    }

    /* Interpolation linéaire inverse :
       angle = 180 - (adcValue * 90 / DARKNESS_THRESHOLD) */
    angle = 180u - ((uint32)adcValue * 90u / DARKNESS_THRESHOLD);

    if (angle > 180u) angle = 180u;
    if (angle < 90u)  angle = 90u;

    return (uint16)angle;
}


