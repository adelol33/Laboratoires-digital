#include "project.h"
#include <stdint.h>

#define SERVO_REPOS    1500u  
#define SERVO_ACTION   1900u


uint16_t score = 0;
uint8_t  gameRunning = 0; 
uint32_t timerMS = 0;

void AffichageAction(char* texte) {
    LCD_Position(0, 0);
    LCD_PrintString("                "); 
    LCD_Position(0, 0);
    LCD_PrintString(texte);
}

void AffichageScore() {
    LCD_Position(1, 0);
    LCD_PrintNumber(score);
    LCD_PrintString("    "); 
}

int main(void)
{
    CyGlobalIntEnable; 
    PWM_Jump_Start();
    PWM_Duck_Start();
    LCD_Start();
    LCD_ClearDisplay();
    AffichageScore();

    for(;;)
    {
        // --- 1. GESTION DU SCORE (Priorité) ---
        if (gameRunning == 1) 
        {
            CyDelay(10); 
            timerMS += 10;
            if (timerMS >= 1000) {
                score += 10;
                timerMS = 0;
                AffichageScore();
            }
        } else {
            CyDelay(10);
        }

        // --- 2. LECTURE DES BOUTONS ---
        // Si tes boutons sont inversés, on va juste changer les noms ici !
        
        // Si SW3 (qui affiche jump actuellement) est pressé
        if (Switch_Jump_Read() == 1u)  // Apparemment c'est ton SW3 qui fait le jump
        {
            AffichageAction("JUMP!");
            if (gameRunning == 0) gameRunning = 1;
        }
        // Si SW1 (qui affiche reset actuellement) est pressé
        else if (Switch_Reset_Read() == 1u) 
        {
            score = 0;
            gameRunning = 0;
            AffichageAction("RESET");
            AffichageScore();
        }
        // On teste le DUCK avec "== 1u" aussi
        else if (Switch_Duck_Read() == 1u)
        {
            AffichageAction("DUCK!");
            PWM_Duck_WriteCompare(SERVO_ACTION);
        }
        // Si rien n'est pressé
        else 
        {
            AffichageAction(""); 
        }
    }
}
