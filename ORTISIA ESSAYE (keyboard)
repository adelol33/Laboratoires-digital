void AffichageLCD(char* action) {
    LCD_Position(0, 0);
    LCD_PrintString("                "); // Efface la ligne du haut
    LCD_Position(0, 0);
    LCD_PrintString(action);      // Affiche "Jump" ou "Duck" 
    LCD_Position(1, 0);           // Deuxième ligne
    LCD_PrintString("Score: ");
    LCD_PrintNumber(score);       // Affiche le score actuel attention ici il faut le mettre à la ligne d'avant
}

void Jump(void)
{
    PWM_Jump_WriteCompare(SERVO_ACTION);
    Led_Jump_1_Write(Switch_Jump_Read());
    Led_Jump_2_Write(Switch_Jump_Read());
}

void Duck(void)
{
    PWM_Duck_WriteCompare(SERVO_ACTION);
    Led_Duck_1_Write(Switch_Duck_Read());
    Led_Duck_2_Write(Switch_Duck_Read());
}


/* -----------------------------------------------
 * Map_ADC_To_Angle
 * Quand obscurité : mappe la valeur ADC (0 -> seuil)
 * sur une plage d'angle (90° -> 180°)
 * Plus il fait sombre, plus l'angle est grand. ATTENTION A METTRE EN COMMUN AVEC LES SERVO QUAND ILS VONT FONCTIONNER!!!!
 * ----------------------------------------------- */
uint16 Map_ADC_To_Angle(int16 adcValue)
{
    uint32 angle;

    if (adcValue < 0) adcValue = 0;

    /* Obscurité totale (ADC = 0)  -> 180°
       Limite obscurité (ADC = seuil) -> 90°  */
    if ((uint16)adcValue >= DARKNESS_THRESHOLD)
    {
        return 90u; /* juste au seuil -> 90° */
    }

    /* Interpolation linéaire inverse :
       angle = 180 - (adcValue * 90 / DARKNESS_THRESHOLD) */
    angle = 180u - ((uint32)adcValue * 90u / DARKNESS_THRESHOLD);

    if (angle > 180u) angle = 180u;
    if (angle < 90u)  angle = 90u;

    return (uint16)angle;
}


